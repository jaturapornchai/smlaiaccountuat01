{
  "id": "smoke-setup-report-1",
  "title": "สำรวจเปิดรายงานทุกตัว: เริ่มต้น",
  "module": "reports",
  "lens": "screen",
  "severityOnFail": "S2",
  "timeoutMs": 185000,
  "description": "เปิดรายงานกลุ่ม เริ่มต้น 5 รายการทีละตัว แล้วตรวจว่าแผงเปิดได้ และไม่มี HTTP 4xx/5xx, JS error, DB error · ไม่กดบันทึก ไม่แก้ข้อมูล",
  "steps": [
    {
      "title": "เข้าสู่ระบบแบบ Demo",
      "do": "ui.demoLogin"
    },
    {
      "title": "ล้างตัวนับข้อผิดพลาดหลังเข้าสู่ระบบ",
      "do": "ui.expectClean",
      "reset": true
    },
    {
      "title": "เปิดรายงาน ออกแบบงบการเงิน",
      "do": "ui.openMenu",
      "key": "menu_gl_report_design",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า ออกแบบงบการเงิน",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน ออกแบบรายงาน",
      "do": "ui.openMenu",
      "key": "fast_report_designer",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า ออกแบบรายงาน",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน นำเข้ารายงาน",
      "do": "ui.openMenu",
      "key": "menu_import_report",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า นำเข้ารายงาน",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน นำเข้ารายงานสาขา",
      "do": "ui.openMenu",
      "key": "menu_import_report_branch",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า นำเข้ารายงานสาขา",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน รายงานพนักงานเรียงตามกลุ่ม",
      "do": "ui.openMenu",
      "key": "menu_report_employee_group",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า รายงานพนักงานเรียงตามกลุ่ม",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    }
  ]
}
