{
  "id": "cb-carry-forward",
  "title": "เอกสารยกมา (ลูกหนี้ เจ้าหนี้ เช็ครับ เช็คจ่าย เงินสด เงินฝาก) และบัตรเครดิตรับ: บันทึกได้ ขึ้นทะเบียน/รายงานคงค้างถูก ขึ้นเงินบัตรถูก แล้วลบคืนไม่เหลือเศษ",
  "module": "recon",
  "lens": "api",
  "severityOnFail": "S2",
  "description": "ทำงานผ่าน API ตัวเดียวกับหน้าจอ: ตั้งหนี้ลูกหนี้ยกมา (93) และเจ้าหนี้ยกมา (81) ต้องขึ้นรายงานใบส่งของค้างชำระ/ค้างจ่ายเต็มยอด · เช็ครับยกมา (405) และเช็คจ่ายยกมา (406) ต้องขึ้นทะเบียนเช็คสถานะเช็คในมือ ขึ้นรายงานเช็ค และเลือกไปนำฝาก/ผ่านได้ · ยกมาเงินสด (602) และเงินฝากธนาคารยกมา (604) ต้องบันทึกได้ (หน้าจอกรอกยอดที่หัวเอกสาร) และเงินฝากยกมาต้องขึ้น Bank Statement · รับชำระหนี้ยกมาด้วยบัตรเครดิต (239) → บัตรขึ้นทะเบียนรอขึ้นเงิน → ขึ้นเงินบัตร (461) → สถานะ/รายงานบัตร/GL/Bank Statement ถูก · ลูกค้า เจ้าหนี้ ยอดเงินดึงจากเอกสารยกมาจริง เช็คจริง และ cb_trans จริงล่าสุด สมุดจาก erp_pass_book ที่ผังบัญชีมีจริง เลขเช็ค/บัตรเป็นของรอบนี้ · cleanup ลบทุกใบผ่าน API ย้อนลำดับ แล้วตรวจว่าไม่เหลือแถว",
  "steps": [
    {
      "title": "กำหนดเลขตั้งหนี้ลูกหนี้ยกมาทดสอบ",
      "do": "set",
      "name": "ea",
      "value": "UAT-{{run.short}}-EA"
    },
    {
      "title": "กำหนดเลขตั้งหนี้เจ้าหนี้ยกมาทดสอบ",
      "do": "set",
      "name": "da",
      "value": "UAT-{{run.short}}-DA"
    },
    {
      "title": "กำหนดเลขเช็ครับยกมาทดสอบ",
      "do": "set",
      "name": "chb",
      "value": "UAT-{{run.short}}-CHB"
    },
    {
      "title": "กำหนดเลขเช็คจ่ายยกมาทดสอบ",
      "do": "set",
      "name": "cpb",
      "value": "UAT-{{run.short}}-CPB"
    },
    {
      "title": "กำหนดเลขยกมาเงินสดทดสอบ",
      "do": "set",
      "name": "cab",
      "value": "UAT-{{run.short}}-CAB"
    },
    {
      "title": "กำหนดเลขเงินฝากธนาคารยกมาทดสอบ",
      "do": "set",
      "name": "bbl",
      "value": "UAT-{{run.short}}-BBL"
    },
    {
      "title": "กำหนดเลขใบรับชำระด้วยบัตรเครดิตทดสอบ",
      "do": "set",
      "name": "ee",
      "value": "UAT-{{run.short}}-EE"
    },
    {
      "title": "กำหนดเลขบันทึกขึ้นเงินบัตรเครดิตทดสอบ",
      "do": "set",
      "name": "crd",
      "value": "UAT-{{run.short}}-CRD"
    },
    {
      "title": "กำหนดเลขเช็ครับยกมาของรอบนี้",
      "do": "set",
      "name": "chqr",
      "value": "UAT{{run.short}}B"
    },
    {
      "title": "กำหนดเลขเช็คจ่ายยกมาของรอบนี้",
      "do": "set",
      "name": "chqp",
      "value": "UAT{{run.short}}Q"
    },
    {
      "title": "กำหนดเลขบัตรเครดิตของรอบนี้",
      "do": "set",
      "name": "card",
      "value": "UAT{{run.short}}K"
    },
    {
      "title": "เข้าสู่ระบบแบบ Demo",
      "do": "ui.demoLogin"
    },
    {
      "title": "ดึงลูกหนี้/เจ้าหนี้และยอดจากเอกสารยกมาจริง ยอดเช็ครับ/จ่ายจากทะเบียนเช็คจริง ยอดเงินสด/เงินโอนจาก cb_trans จริง สมุดและผังบัญชีจริง",
      "do": "db.query",
      "sql": "with ar as (select t.cust_code, round(t.total_amount, 2) as amt, coalesce(t.doc_format_code, '') as fmt from ic_trans t join ar_customer c on c.code = t.cust_code where t.trans_flag = 93 and t.doc_no not like 'UAT%' and t.last_status = 0 and t.total_amount > 0 order by t.doc_date desc, t.roworder desc limit 1), ap as (select t.cust_code, round(t.total_amount, 2) as amt, coalesce(t.doc_format_code, '') as fmt from ic_trans t join ap_supplier s on s.code = t.cust_code where t.trans_flag = 81 and t.doc_no not like 'UAT%' and t.last_status = 0 and t.total_amount > 0 order by t.doc_date desc, t.roworder desc limit 1), ci as (select q.ap_ar_code, q.amount from cb_chq_list q join ar_customer c on c.code = q.ap_ar_code where q.chq_type = 1 and q.chq_number not like 'UAT%' and q.amount > 0 order by q.roworder desc limit 1), co as (select q.ap_ar_code, q.amount from cb_chq_list q join ap_supplier s on s.code = q.ap_ar_code where q.chq_type = 2 and q.chq_number not like 'UAT%' and q.amount > 0 order by q.roworder desc limit 1), b as (select p.code, p.account_code_1 as acc from erp_pass_book p join gl_chart_of_account c on c.code = p.account_code_1 order by p.code limit 1) select ar.cust_code as cust, ar.amt::text as amt_ar, (-ar.amt)::text as neg_ar, ar.fmt as eafmt, ap.cust_code as supp, ap.amt::text as amt_ap, ap.fmt as dafmt, ci.ap_ar_code as chq_cust, round(ci.amount, 2)::text as amt_ci, co.ap_ar_code as chq_supp, round(co.amount, 2)::text as amt_co, (select round(cash_amount, 2)::text from cb_trans where doc_no not like 'UAT%' and cash_amount > 0 order by roworder desc limit 1) as amt_cash, (select round(tranfer_amount, 2)::text from cb_trans where doc_no not like 'UAT%' and tranfer_amount > 0 order by roworder desc limit 1) as amt_bank, (select doc_format_code from ap_ar_trans where trans_flag = 239 and doc_no not like 'UAT%' and coalesce(doc_format_code, '') <> '' order by roworder desc limit 1) as eefmt, b.code as book, b.acc, (select code from gl_chart_of_account where name_1 like 'ลูกหนี้การค้า%' order by code limit 1) as ar_acc, to_char((now() at time zone 'Asia/Bangkok')::date, 'YYYY-MM-DD') as today from ar, ap, ci, co, b",
      "rows": 1,
      "expect": [
        {
          "col": "amt_ar",
          "op": "gt",
          "value": "0"
        },
        {
          "col": "amt_ap",
          "op": "gt",
          "value": "0"
        },
        {
          "col": "amt_ci",
          "op": "gt",
          "value": "0"
        },
        {
          "col": "amt_co",
          "op": "gt",
          "value": "0"
        },
        {
          "col": "amt_cash",
          "op": "gt",
          "value": "0"
        },
        {
          "col": "amt_bank",
          "op": "gt",
          "value": "0"
        },
        {
          "col": "eefmt",
          "op": "exists"
        },
        {
          "col": "book",
          "op": "exists"
        }
      ],
      "save": {
        "cust": "cust",
        "amt_ar": "amt_ar",
        "neg_ar": "neg_ar",
        "eafmt": "eafmt",
        "supp": "supp",
        "amt_ap": "amt_ap",
        "dafmt": "dafmt",
        "chq_cust": "chq_cust",
        "amt_ci": "amt_ci",
        "chq_supp": "chq_supp",
        "amt_co": "amt_co",
        "amt_cash": "amt_cash",
        "amt_bank": "amt_bank",
        "eefmt": "eefmt",
        "book": "book",
        "acc": "acc",
        "ar_acc": "ar_acc",
        "today": "today"
      }
    },
    {
      "title": "บันทึกตั้งหนี้ลูกหนี้ยกมา (93) กรอกยอดที่หัวเอกสาร",
