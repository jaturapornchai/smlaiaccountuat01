      "title": "เปิดเมนู ข้อมูลรายวัน",
      "do": "ui.openMenu",
      "key": "menu_audit_trans",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า ข้อมูลรายวัน",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    }
  ]
