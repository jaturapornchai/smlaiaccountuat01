{
  "id": "smoke-asset-report-1",
  "title": "สำรวจเปิดรายงานทุกตัว: ค่าเสื่อม",
  "module": "reports",
  "lens": "screen",
  "severityOnFail": "S2",
  "timeoutMs": 160000,
  "description": "เปิดรายงานกลุ่ม ค่าเสื่อม 4 รายการทีละตัว แล้วตรวจว่าแผงเปิดได้ และไม่มี HTTP 4xx/5xx, JS error, DB error · ไม่กดบันทึก ไม่แก้ข้อมูล",
  "steps": [
    {
      "title": "เข้าสู่ระบบแบบ Demo",
      "do": "ui.demoLogin"
    },
    {
      "title": "ล้างตัวนับข้อผิดพลาดหลังเข้าสู่ระบบ",
      "do": "ui.expectClean",
      "reset": true
    },
    {
      "title": "เปิดรายงาน รายงานรายละเอียดสินทรัพย์",
      "do": "ui.openMenu",
      "key": "menu_asset_report_list",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า รายงานรายละเอียดสินทรัพย์",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน รายงานค่าเสื่อมราคาสินทรัพย์",
      "do": "ui.openMenu",
      "key": "menu_asset_report_depreciate",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า รายงานค่าเสื่อมราคาสินทรัพย์",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน รายงานการซ่อมบำรุงสินทรัพย์",
      "do": "ui.openMenu",
      "key": "menu_asset_report_maintain",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า รายงานการซ่อมบำรุงสินทรัพย์",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดรายงาน รายงานอื่น ๆ",
      "do": "ui.openMenu",
      "key": "menu_fastreport_other_asset",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า รายงานอื่น ๆ",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    }
  ]
}
