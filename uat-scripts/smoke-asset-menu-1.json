{
  "id": "smoke-asset-menu-1",
  "title": "สำรวจเปิดเมนูทุกตัว: ค่าเสื่อม",
  "module": "gl",
  "lens": "screen",
  "severityOnFail": "S2",
  "timeoutMs": 260000,
  "description": "เปิดเมนูกลุ่ม ค่าเสื่อม 8 รายการทีละตัว แล้วตรวจว่าแผงเปิดได้ และไม่มี HTTP 4xx/5xx, JS error, DB error · ไม่กดบันทึก ไม่แก้ข้อมูล",
  "steps": [
    {
      "title": "เข้าสู่ระบบแบบ Demo",
      "do": "ui.demoLogin"
    },
    {
      "title": "ล้างตัวนับข้อผิดพลาดหลังเข้าสู่ระบบ",
      "do": "ui.expectClean",
      "reset": true
    },
    {
      "title": "เปิดเมนู ข้อมูลสินทรัพย์",
      "do": "ui.openMenu",
      "key": "menu_asset_lists",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า ข้อมูลสินทรัพย์",
      "do": "ui.expectClean",
      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดเมนู กำหนดรูปภาพ",
      "do": "ui.openMenu",
      "key": "menu_asset_picture",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า กำหนดรูปภาพ",
