      "ignore": [
        "^HTTP 401 GET /api/auth/"
      ],
      "continueOnFail": true
    },
    {
      "title": "เปิดเมนู โอนข้อมูลเข้าระบบบัญชี",
      "do": "ui.openMenu",
      "key": "menu_asset_transfers",
      "timeout": 20000,
      "continueOnFail": true
    },
    {
      "title": "ไม่มีข้อผิดพลาดแฝงในหน้า โอนข้อมูลเข้าระบบบัญชี",
