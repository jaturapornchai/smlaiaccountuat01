# เว็บ ERP ที่จะทดสอบ (แก้ในหน้าตั้งค่าได้ด้วย)
ERP_TARGET_URL=https://www.smlwork.com

# ฐานข้อมูล PostgreSQL ของ Demo — ใช้เฉพาะขั้นตอน db.* ของสคริปต์ (ใส่ค่าจริงใน .env.local ห้ามคอมมิต)
UAT_PG_HOST=
UAT_PG_PORT=5432
UAT_PG_USER=
UAT_PG_PASSWORD=
UAT_PG_DATABASE=smldemo
# ตัวรันจะปฏิเสธทุกขั้นตอน db.* ถ้าฐานที่ต่ออยู่ไม่อยู่ในรายการนี้ (คั่นด้วย ,)
UAT_PG_ALLOW_DB=smldemo
# ตำแหน่ง psql.exe และ Playwright ที่มีอยู่แล้วในเครื่อง (ไม่ต้องติดตั้งเพิ่ม)
UAT_PSQL=C:/Program Files/PostgreSQL/18/bin/psql.exe
UAT_PLAYWRIGHT=D:/smlaiaccount/tests/playwright/node_modules/playwright/index.mjs
# 1 = เปิดหน้าต่าง Chrome ให้เห็นตอนรัน
UAT_HEADED=

# สมองของบอท = Ollama Cloud (สร้างคีย์ที่ ollama.com/settings/keys)
OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY=
# ว่างไว้ = deepseek-v4.1-flash (เร็ว อ่านภาพได้) · เปลี่ยนในหน้าตั้งค่าได้
OLLAMA_MODEL=

# IssueMate — รอบที่ไม่ผ่านจะถูกเปิดเป็น issue ให้แก้โปรแกรมต่อ
ISSUEMATE_MCP_URL=https://issue.dedezoom.com/mcp?project=SMLAIACC
ISSUEMATE_PROJECT=SMLAIACC
ISSUEMATE_TOKEN=
# 0 = ไม่ส่งอัตโนมัติ (ยังกดส่งเองจากหน้ารอบการรันได้)
ISSUEMATE_AUTO=

# MCP ให้ AI (Claude/Antigravity) สั่งงาน: Authorization: Bearer <ค่านี้> — สุ่มยาว ๆ ห้าม commit ค่าจริง
UAT_MCP_TOKEN=

# คุกกี้ผู้ดูแลที่เข้าสู่ระบบ Google (สุ่มยาว ≥32 ตัว)
UAT_SESSION_SECRET=
# อีเมล Google ของผู้ดูแลที่สั่งงานผ่านหน้าเว็บได้ (จำเป็น)
UAT_ADMIN_EMAIL=
# GOOGLE_CLIENT_ID=
